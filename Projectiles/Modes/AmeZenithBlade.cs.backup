using Microsoft.Xna.Framework;
using Microsoft.Xna.Framework.Graphics;
using Terraria;
using Terraria.ID;
using Terraria.ModLoader;
using Terraria.DataStructures;
using System;

namespace Ame.Projectiles.Modes
{
	/// <summary>
	/// Proyectil estilo Zenith - Espada que sigue trayectoria curva, ignora bloques y regresa al jugador
	/// </summary>
	public class AmeZenithBlade : ModProjectile
	{
		private Vector2 startPos;
		private Vector2 targetPos;

		// ai[0] = progreso (0 a 1)
		// ai[1] = dirección curva (1 o -1)

		public override void SetStaticDefaults()
		{
			// DisplayName se maneja via localización
			ProjectileID.Sets.TrailCacheLength[Projectile.type] = 10;
			ProjectileID.Sets.TrailingMode[Projectile.type] = 2;
		}

		public override void SetDefaults()
		{
			Projectile.width = 60;
			Projectile.height = 60;

			Projectile.friendly = true;
			Projectile.DamageType = DamageClass.Melee;

			Projectile.penetrate = -1;
			Projectile.timeLeft = 300;  // Más tiempo para completar la trayectoria

			Projectile.tileCollide = false;
			Projectile.ignoreWater = true;

			Projectile.extraUpdates = 1; // Más fluido
			Projectile.usesLocalNPCImmunity = true;
			Projectile.localNPCHitCooldown = 10;
		}

		public override void OnSpawn(IEntitySource source)
		{
			Player player = Main.player[Projectile.owner];

			startPos = player.Center;
			targetPos = Main.MouseWorld;

			Projectile.ai[0] = 0f;
		}

		public override void AI()
		{
			Player player = Main.player[Projectile.owner];

			// Velocidad de movimiento - MÁS RÁPIDO que Zenith
			float speed = 0.016f;  // Más lento para completar la trayectoria
			Projectile.ai[0] += speed;

			float progress = Projectile.ai[0];

			// Extender el tiempo de vida para permitir que complete el recorrido
			if (progress >= 1f)
			{
				Projectile.Kill();
				return;
			}

			// Actualizar posiciones cada frame (importante para arcos dinámicos)
			if (Projectile.ai[0] == speed || startPos == Vector2.Zero)
			{
				startPos = player.Center;
				targetPos = Main.MouseWorld;
			}

			// Sistema de ida y regreso mejorado
			Vector2 from, to;
			float currentProgress;

			if (progress <= 0.5f)
			{
				// FASE 1: Ida hacia el cursor (0 a 0.5)
				from = startPos;
				to = targetPos;
				currentProgress = progress * 2f;  // Normalizar a 0-1
			}
			else
			{
				// FASE 2: Regreso al jugador (0.5 a 1.0)
				from = targetPos;
				to = player.Center;  // Actualizar destino al centro actual del jugador
				currentProgress = (progress - 0.5f) * 2f;  // Normalizar a 0-1
			}

			// Interpolación lineal base (trayectoria directa)
			Vector2 linear = Vector2.Lerp(from, to, currentProgress);

			// Calcular curvatura tipo Zenith (función seno para arco suave)
			float curve = (float)Math.Sin(currentProgress * MathHelper.Pi);
			
			// Dirección perpendicular para aplicar la curva
			Vector2 direction = (to - from).SafeNormalize(Vector2.UnitX);
			Vector2 perpendicular = direction.RotatedBy(MathHelper.PiOver2);

			// Fuerza de curvatura variada (cada espada diferente)
			// ai[1] contiene: dirección (-1 o 1) * variación (0.5 a 2.0)
			float curveStrength = 120f * Projectile.ai[1];

			// Aplicar posición final con curva
			Projectile.Center = linear + perpendicular * curve * curveStrength;

			// Rotación continua para efecto visual
			Projectile.rotation += 0.4f;

			// Ajustar dirección visual hacia donde se mueve
			if (Projectile.velocity != Vector2.Zero)
			{
				Projectile.rotation = Projectile.velocity.ToRotation() + MathHelper.PiOver4;
			}

			// Efectos visuales
			if (Main.rand.NextBool(3))
			{
				Dust dust = Dust.NewDustDirect(Projectile.position, Projectile.width, Projectile.height,
					DustID.Shadowflame, 0f, 0f, 100, default, 1.2f);
				dust.noGravity = true;
				dust.velocity *= 0.3f;
			}
		}

		/// <summary>
		/// Colisión tipo línea - Sistema real de la Zenith
		/// Detecta golpes usando una línea en lugar de un rectángulo
		/// </summary>
		public override bool? Colliding(Rectangle projHitbox, Rectangle targetHitbox)
		{
			// Primero, verificar colisión rectangular básica (hitbox expandido)
			if (!projHitbox.Intersects(targetHitbox))
			{
				return false;
			}

			// Luego, verificar colisión de línea más precisa
			float collisionPoint = 0f;

			Vector2 lineStart = Projectile.Center;
			Vector2 lineDirection = Projectile.rotation.ToRotationVector2();
			Vector2 lineEnd = lineStart + lineDirection * 100f;

			if (Collision.CheckAABBvLineCollision(
				targetHitbox.TopLeft(),
				targetHitbox.Size(),
				lineStart,
				lineEnd,
				25f,
				ref collisionPoint))
			{
				return true;
			}

			// Fallback: si está muy cerca, también golpea
			return Vector2.Distance(Projectile.Center, targetHitbox.Center.ToVector2()) < 60f;
		}

		public override void OnHitNPC(NPC target, NPC.HitInfo hit, int damageDone)
		{
			// Log para debugging (opcional)
			// Main.NewText($"¡Golpe a {target.FullName}! Daño: {damageDone}", new Color(255, 200, 100));

			// Efecto de impacto
			for (int i = 0; i < 8; i++)
			{
				Dust dust = Dust.NewDustDirect(Projectile.position, Projectile.width, Projectile.height,
					DustID.Shadowflame, 0f, 0f, 100, default, 1.5f);
				dust.noGravity = true;
				dust.velocity *= 2f;
			}

			// Aplicar knockback adicional
			target.velocity += Projectile.velocity.SafeNormalize(Vector2.UnitY) * 3f;
		}

		public override bool PreDraw(ref Color lightColor)
		{
			// Trail effect (estela)
			Main.instance.LoadProjectile(Projectile.type);
			Texture2D texture = Terraria.GameContent.TextureAssets.Projectile[Projectile.type].Value;

			Vector2 drawOrigin = new Vector2(texture.Width * 0.5f, Projectile.height * 0.5f);

			for (int k = 0; k < Projectile.oldPos.Length; k++)
			{
				Vector2 drawPos = Projectile.oldPos[k] - Main.screenPosition + drawOrigin + new Vector2(0f, Projectile.gfxOffY);
				Color color = Projectile.GetAlpha(lightColor) * ((Projectile.oldPos.Length - k) / (float)Projectile.oldPos.Length);
				Main.EntitySpriteDraw(texture, drawPos, null, color * 0.5f, Projectile.rotation, drawOrigin, Projectile.scale, SpriteEffects.None, 0);
			}

			return true;
		}
	}
}
